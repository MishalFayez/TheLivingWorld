script = ExtResource("3_wxd6r")
id = "shield_rush"
display_name = "Shield Rush"
description = "Forward shield charge that damages, generates heavy threat and can INTERCEPT: aimed toward an endangered ally it rushes to them and takes the next blow aimed at them. With 30 Resolve it becomes an Empowered Rush (staggering impact)."
