func _init() -> void:
	var n := 0
	for e in catalog():
		var a := AugmentData.new()
		a.id = e.id
		a.code = e.code
		a.display_name = e.name
		a.description = e.desc
		a.class_id = e.cls
		a.path_id = e.get("path", "")
		a.rarity = e.rarity
		a.is_anchor = e.get("anchor", false)
		a.category = "mutation" if e.get("anchor", false) or e.get("transforms", "") != "" else ("synergy" if not e.get("partners", {}).is_empty() else "enhancement")
		a.pool = "l10"
		a.trigger_summary = e.trigger
		a.cooldown = float(e.get("cd", 0.0))
		a.mechanical_tradeoff = e.get("tradeoff", "")
		a.scaling_sources = PackedStringArray(e.get("scaling", []))
		a.synergy_partners = PackedStringArray(e.get("partners", {}).keys())
		a.synergy_text = e.get("partners", {})
		a.synergy_kind = e.get("kinds", {})
		a.short_text = String(SHORT.get(e.id, ""))
		a.requires_party = e.get("party", false)
		a.synergy_tags = PackedStringArray(e.get("tags", []))
		a.requires_unlocks = PackedStringArray(e.get("req", []))
		a.exclusive_group = e.get("group", "")
		a.transforms = e.get("transforms", "")
		a.blocked_reason = e.get("blocked", "")
		a.blocked_classes = PackedStringArray(e.get("blocked_classes", []))
		a.params = e.get("params", {})
		var err := ResourceSaver.save(a, OUT + a.id + ".tres")
		if err != OK:
			push_error("save failed: " + a.id)
		n += 1
	print("generated %d augments" % n)
	quit(0)


